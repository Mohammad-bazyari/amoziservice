[TEMPLATE]
# Copy this file to .env and fill in real values.
# On cPanel you can either keep this file or set the same variables in
# "Setup Python App" → Environment variables (the panel approach is safer).

# ---------------------------------------------------------------
# 1) Django core
# ---------------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# MUST be False on the host.
DJANGO_DEBUG=False

# Comma-separated. Add your domain (and www) here.
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Required for HTTPS admin/login POSTs on cPanel (include the scheme).
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

DJANGO_TIME_ZONE=Asia/Tehran

# ---------------------------------------------------------------
# 2) Database — create it first in cPanel → MySQL Databases
#    (user name and DB name get the cPanel account prefix)
# ---------------------------------------------------------------
# DATABASE_URL=mysql://cpaneluser_dbuser:DB-PASSWORD@localhost:3306/cpaneluser_dbname

# ---------------------------------------------------------------
# 3) HTTPS hardening (leave defaults; set to False only if the
#    site temporarily has no SSL certificate)
# ---------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000

# ---------------------------------------------------------------
# 4) SMS — Kavenegar (https://kavenegar.com)
#    Until you set KAVENEGAR_ENABLED=True, a mock provider is used
#    and nothing is sent (messages are only logged in SmsLog).
# ---------------------------------------------------------------
KAVENEGAR_ENABLED=False
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
