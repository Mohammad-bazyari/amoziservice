# Persian translations for the requests app.
#
# این فایل «مرجع واحد متن» جریان ثبت درخواست است: همه‌ی پیام‌های کاربرنمای
# apps/requests/messages.py → اینجا مشخص می‌شود که لحن‌شان چیست.
#
# • برای اصلاح لحن یا غلط‌گیری: فقط msgstr را ویرایش کنید و سپس mo را دوباره
#   کامپایل کنید (compilemessages یا `polib.save_as_mofile`).
# • msgid = رشته‌ی داخل کد است؛ آن را تغییر ندهید تا با makemessages هم‌پوشان
#   بماند.
# • «{max}» جا‌انگهدار است و موقع ساخته‌شدن پیام با عدد فارسی پر می‌شود.
#
msgid ""
msgstr ""
"Project-Id-Version: requests\n"
"Report-Msgid-Bugs-To: \n"
"Language: fa\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 0);\n"

# ---------------------------------------------------------------------------
# قواعد مشترک سرور و کلاینت (منتقل‌شده به data-pattern / data-error-pattern)
# ---------------------------------------------------------------------------
#. شماره موبایل — با placeholder میدان (09121234567) هم‌راستا؛ ارقام لاتین
#. چون میدان dir=ltr است و خود کاربر همان را می‌نویسد.
msgid "شماره موبایل معتبر نیست (مثال: 09121234567)."
msgstr "شماره موبایل معتبر نیست (مثال: 09121234567)."

#. کد پستی
msgid "کد پستی باید فقط شامل رقم باشد."
msgstr "کد پستی باید فقط شامل رقم باشد."

# ---------------------------------------------------------------------------
# خطاهای میدان‌ها (wizard)
# ---------------------------------------------------------------------------
#. پیغام «الزامی» — عمداً با متن سمت کلاینت (wizard-form.js) یکسان است تا
#. اعلان و صفحه یک صدا باشند.
msgid "این بخش را کامل کنید."
msgstr "این بخش را کامل کنید."

#. گزینه‌های ازبین‌رفته (خارج از خدمت، غیرفعال‌شده …)
msgid "گزینه انتخابی معتبر نیست."
msgstr "گزینه انتخابی معتبر نیست."

#. برند/مشکل آزاد وقتی لیست نداریم
msgid "ابتدا خدمت موردنظر را انتخاب کنید."
msgstr "ابتدا خدمت موردنظر را انتخاب کنید."

#. نام برند (گزینه «سایر»)
msgid "نام برند را وارد کنید."
msgstr "نام برند را وارد کنید."

#. شرح مشکل (گزینه «سایر»)
msgid "شرح مشکل را وارد کنید."
msgstr "شرح مشکل را وارد کنید."

# ---------------------------------------------------------------------------
# خطاهای آپلود تصاویر
# ---------------------------------------------------------------------------
#. فرمت — با accept میدان هم‌راستا
msgid "فرمت تصویر مجاز نیست (فقط JPG، PNG یا WebP)."
msgstr "فرمت تصویر مجاز نیست (فقط JPG، PNG یا WebP)."

#. MIME
msgid "نوع فایل مجاز نیست (فقط تصویر)."
msgstr "نوع فایل مجاز نیست (فقط تصویر)."

#. محتوای واقعی (Pillow) — فایل جعل‌شده
msgid "فایل ارسالی یک تصویر معتبر نیست."
msgstr "فایل ارسالی یک تصویر معتبر نیست."

#. حجم — {max} با ارقام فارسی + واحد مگابایت پر می‌شود (image_size_error)
msgid "حجم تصویر نباید بیشتر از {max} باشد."
msgstr "حجم تصویر نباید بیشتر از {max} باشد."

#. تعداد — {max} با ارقام فارسی پر می‌شود (image_count_error)
msgid "حداکثر {max} تصویر می‌توانید ارسال کنید."
msgstr "حداکثر {max} تصویر می‌توانید ارسال کنید."

# ---------------------------------------------------------------------------
# پیام‌های framework (redirect / submit)
# ---------------------------------------------------------------------------
#. مرگ اطلاعات — اعمال در review_view و submit_view (یک پیام واحد)
msgid "اطلاعات درخواست کامل نیست؛ لطفاً مراحل را از ابتدا طی کنید."
msgstr "اطلاعات درخواست کامل نیست؛ لطفاً مراحل را از ابتدا طی کنید."

#. خطای ثبت — خطای DB / خطای سرور
msgid "خطایی در ثبت درخواست رخ داد. لطفاً دوباره تلاش کنید."
msgstr "خطایی در ثبت درخواست رخ داد. لطفاً دوباره تلاش کنید."

#. درخواست تکراری — submit تکراری (طرز refresh)
msgid "این درخواست قبلاً ثبت شده است."
msgstr "این درخواست قبلاً ثبت شده است."

#. مرحله‌ی ناموجود — Http404
msgid "مرحله نامعتبر است."
msgstr "مرحله نامعتبر است."
